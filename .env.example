# Port the engine listens on. The built UI is served from the same port.
PORT=8899

# Where the follow list, webhook and screener cache are written.
DATA_DIR=./data

# Gate for every page and /api route. Leave empty to run without a passcode.
SITE_PASSCODE=

# Optional: a Discord webhook is set from the Following tab and stored in DATA_DIR,
# so it does not belong in this file.
